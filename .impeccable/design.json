  "narrative": {
    "northStar": "Metro Wayfinding",
    "overview": "A songbook read like transit signage. Each karaoke machine model is a coloured line; the selected model is a flat bar of that colour pinned to the top of the list. Every song number is a plain, heavy station number at the right edge of a ruled row, and tapping a row opens it as a big read-out sign. Light is the first design; dark is a full matching version that follows the phone.\n\nThe surface is calm and clean: cool off-white wall, white sign surfaces, ink text, hairline rules. Colour is reserved for the six lines and the yellow logo disc. Chrome (brand, selection, focus, primary button) is ink. Depth is flat fills and rules.",
    "keyCharacteristics": [
      "Light by default, dark via data-theme following the phone.",
      "Ink is the brand: brand, select and focus are ink in light and near-white in dark.",
      "One colour per model (a line), always paired with a written model name.",
      "Song numbers in Barlow Semi Condensed bold, tabular, the largest thing on any row.",
      "Every interactive target at least 3rem tall.",
      "Ruled lists, not boxed cards; flat fills; no gradients, no glow."
    ],
    "rules": [
      {
        "name": "The Ink Chrome Rule",
        "body": "Brand, selection, focus and the primary button are ink, never a line colour. Line colours mean \"this machine model\" and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Name Beside Colour Rule",
        "body": "A line colour is never the only identifier; the model name is always written out beside it.",
        "section": "colors"
      },
      {
        "name": "The Station Number Rule",
        "body": "Song numbers always use the display face, tabular figures and weight 700; they are never styled as decoration, glowing or segmented.",
        "section": "typography"
      },
      {
        "name": "The Flat Sign Rule",
        "body": "No gradients, glows or card shadows. A sign is a flat fill with a hairline or 2px border.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep light as the default and dark as a full second design that follows the phone.",
      "Do set a model's colour only through the hue-* class (--hue, --on-hue) and read those two variables everywhere.",
      "Do keep every target at least 3rem tall and every text/background pair at AA.",
      "Do use rules, fills and spacing for structure; keep lists ruled.",
      "Do render song numbers via the shared number token with the display face, tabular figures, weight 700."
    ],
    "donts": [
      "Don't use a line colour for brand, selection or focus.",
      "Don't reintroduce the scoreboard look: segmented/LED numerals, neon, glow, pink-purple.",
      "Don't put gradients or card shadows on surfaces, or box each row in a card.",
      "Don't rely on colour alone to tell models apart.",
      "Don't add display faces beyond Barlow Semi Condensed, or use it for running text."
    ]
  }
}
