# Plain Docker only: copy to .env (never commit it) and fill in. Coolify does not use this file; it shows the
# same names as fields to fill in (docs/deployment.md, "Deploying with Coolify").

# Publish the web container on the host (compose.hostport.yml) for a reverse proxy on this machine.
# Do not set this in Coolify.
COMPOSE_FILE=docker-compose.yml:compose.hostport.yml

# --- The site -----------------------------------------------------------------------------
# The exact address people open, with no trailing slash. Requests from any other origin are refused.
ALLOWED_ORIGINS=https://kantahan.example

# Where the web container listens on the host (plain Docker). Keep it on loopback and let your reverse proxy
# (Caddy, Traefik, nginx) forward to it. Use 0.0.0.0:8080 only on a private network.
WEB_BIND=127.0.0.1:8080

# --- Mail: how requests reach you ------------------------------------------------------------
# Rights and correction requests are e-mailed to CONTACT_TO. The address exists only here; it is
# never put in the app, the repository or any response.
CONTACT_TO=you@example.net
SMTP_HOST=smtp.example.net
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (a local relay only)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Shown as the sender; use an address your mail provider lets you send from.
SMTP_FROM=Kantahan <contact@kantahan.example>

# --- Limits (defaults shown) -----------------------------------------------------------------
# RATE_PER_IP_HOUR=5
# RATE_GLOBAL_HOUR=60
# MAX_MESSAGE_CHARS=2000

# Backups go to the `catalog-backups` Docker volume (see docs/deployment.md for copying them off the server).
